{
  "name": "analyzegit-microservices",
  "version": "2.0.0",
  "description": "AnalyzeGit - Enterprise Microservices Architecture",
  "main": "services/gateway/server.js",
  "scripts": {
    "build": "npm install --prefix shared && npm install --prefix services/gateway && npm install --prefix services/auth-service && npm install --prefix services/recruitment-service && npm install --prefix services/analysis-service && npm install --prefix services/worker-service",
    "postinstall": "npm run build",
    "start": "node start-services.js",
    "start:gateway": "cd services/gateway && npm start",
    "start:auth": "cd services/auth-service && npm start",
    "start:recruitment": "cd services/recruitment-service && npm start",
    "start:analysis": "cd services/analysis-service && npm start",
    "start:worker": "cd services/worker-service && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "concurrently": "^9.2.4"
  },
  "keywords": [
    "microservices",
    "analyzegit",
    "docker",
    "ai",
    "github"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
